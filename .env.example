# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=changeme-generate-a-random-secret

POSTGRES_USER=holdview
POSTGRES_PASSWORD=changeme
POSTGRES_DB=holdview

# URL the frontend uses to reach the backend (baked into the frontend build).
BACKEND_URL=http://localhost:8000

# Comma-separated list of origins the backend will accept CORS requests from.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Only needed for docker-compose.prod.yml (Caddy/HTTPS). Point both at this
# host via DNS A records before starting. Once set, update BACKEND_URL to
# https://<API_DOMAIN> and FRONTEND_ORIGINS to include https://<PUBLIC_DOMAIN>.
PUBLIC_DOMAIN=holdview.example.com
API_DOMAIN=api.holdview.example.com
